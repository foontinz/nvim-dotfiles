<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.barbos.google-workspace-mcp</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__GOOGLE_WORKSPACE_MCP_SCRIPT__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/google-workspace-mcp.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/google-workspace-mcp.err.log</string>
</dict>
</plist>
